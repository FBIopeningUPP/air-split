# The right half is the central: it talks to the computer and relays the left half's keys.
if SHIELD_AIR75_SPLIT_RIGHT

config ZMK_KEYBOARD_NAME
    default "Air75 Split"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif

if SHIELD_AIR75_SPLIT_LEFT || SHIELD_AIR75_SPLIT_RIGHT

config ZMK_SPLIT
    default y

config ZMK_DISPLAY
    default y

if ZMK_DISPLAY

config I2C
    default y

config SSD1306
    default y

# The animated screens in src/air75_oled (turn them off with CONFIG_ZMK_DISPLAY_STATUS_SCREEN_BUILT_IN=y)
choice ZMK_DISPLAY_STATUS_SCREEN
    default ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
endchoice

choice ZMK_DISPLAY_WORK_QUEUE
    default ZMK_DISPLAY_WORK_QUEUE_DEDICATED
endchoice

endif

# 1-bit LVGL for the monochrome SSD1306, as on the Corne
if LVGL

config LV_Z_VDB_SIZE
    default 64

config LV_DPI_DEF
    default 148

config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

endif

endif
