# The right half is the central (it talks to the computer): it has the bigger 402060 battery.
if SHIELD_AIR75_SPLIT_RIGHT

config ZMK_KEYBOARD_NAME
    default "Air75 Split"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif

if SHIELD_AIR75_SPLIT_LEFT || SHIELD_AIR75_SPLIT_RIGHT

config ZMK_SPLIT
    default y

config ZMK_DISPLAY
    default y

if ZMK_DISPLAY

config I2C
    default y

config SSD1306
    default y

endif

endif
