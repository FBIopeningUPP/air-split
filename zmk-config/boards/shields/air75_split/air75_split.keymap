#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/*
 * Base: Air75 layout without the function row. Hold Fn (the 1.25u key at the right end of the left half's bottom row):
 *   Fn+Esc `      Fn+1..= F1..F12     Fn+Bksp Delete    Fn+Del Insert     Fn+PgUp Home    Fn+End Print Screen
 *   Fn+Q/W/E/R Bluetooth profile 1-4, Fn+T clear profile, Fn+Y USB output, Fn+U Bluetooth output
 *   Fn+[ / ] brightness, Fn+P play/pause, Fn+M mute, Fn+Up/Down volume, Fn+Left/Right previous/next track
 *   Fn+Backslash bootloader
 */
/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
                &kp ESC         &kp N1          &kp N2          &kp N3          &kp N4          &kp N5          &kp N6      &kp N7          &kp N8          &kp N9          &kp N0          &kp MINUS       &kp EQUAL       &kp BSPC        &kp DEL
                &kp TAB         &kp Q           &kp W           &kp E           &kp R           &kp T      &kp Y           &kp U           &kp I           &kp O           &kp P           &kp LBKT        &kp RBKT        &kp BSLH        &kp PG_UP
                &kp CAPS        &kp A           &kp S           &kp D           &kp F           &kp G      &kp H           &kp J           &kp K           &kp L           &kp SEMI        &kp SQT         &kp RET         &kp PG_DN
                &kp LSHFT       &kp Z           &kp X           &kp C           &kp V           &kp B      &kp N           &kp M           &kp COMMA       &kp DOT         &kp FSLH        &kp RSHFT       &kp UP          &kp END
                &kp LCTRL       &kp LGUI        &kp LALT        &kp SPACE       &mo 1      &kp SPACE       &kp RALT        &kp K_APP       &kp RCTRL       &kp LEFT        &kp DOWN        &kp RIGHT
            >;
        };

        fn_layer {
            display-name = "Fn";
            bindings = <
                &kp GRAVE       &kp F1          &kp F2          &kp F3          &kp F4          &kp F5          &kp F6      &kp F7          &kp F8          &kp F9          &kp F10         &kp F11         &kp F12         &kp DEL         &kp INS
                &trans          &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_CLR      &out OUT_USB    &out OUT_BLE    &trans          &trans          &kp C_PP        &kp C_BRI_DN    &kp C_BRI_UP    &bootloader     &kp HOME
                &trans          &trans          &trans          &trans          &trans          &trans      &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans
                &trans          &trans          &trans          &trans          &trans          &trans      &trans          &kp C_MUTE      &trans          &trans          &trans          &trans          &kp C_VOL_UP    &kp PSCRN
                &trans          &trans          &trans          &trans          &trans      &trans          &trans          &trans          &trans          &kp C_PREV      &kp C_VOL_DN    &kp C_NEXT
            >;
        };
    };
};
